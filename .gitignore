# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backup files
/backups/

# database
.db*
data/dramamancer.db
*.db
/data

# credentials
credentials.json

# Python 가상환경
venv/
.venv/
env/

# Python 캐시 파일 (속도 향상용 임시 파일)
__pycache__/
*.pyc
*.pyo

# IDE / 에디터 설정 파일
.vscode/
.idea/